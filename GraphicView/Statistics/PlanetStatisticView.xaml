<UserControl x:Class="GraphicView.Statistics.PlanetStatisticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.Statistics"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Image Source="/Images/galaxy-screen3.jpg" Stretch="UniformToFill"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50 50 50 0">

            <FlowDocumentScrollViewer IsToolBarVisible="False" VerticalScrollBarVisibility="Hidden">
                <FlowDocument>

                    <Table CellSpacing="5">

                        <Table.Columns>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                        </Table.Columns>

                        <TableRowGroup>

                            <TableRow Background="#FF80364E">
                                <TableCell ColumnSpan="9" TextAlignment="Center">
                                    <Paragraph FontWeight="DemiBold" FontSize="35" Foreground="AliceBlue">Sol Dominium</Paragraph>
                                </TableCell>
                            </TableRow>

                                <TableRow Background="PaleVioletRed" Foreground="AliceBlue" FontSize="14" FontWeight="DemiBold">
                                <TableCell>
                                    <Paragraph TextAlignment="Center" >Planeta</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center" >Żywność</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Energia</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Zadowolenie społeczne</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Autorytet władzy</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Produkcja żywności (co turę)</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Produkcja energii (co turę)</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Zużycie żywności (co turę)</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Zużycie energii (co turę)</Paragraph>
                                </TableCell>
                            </TableRow>
                        </TableRowGroup>
                        <TableRowGroup x:Name="PlanetRows" FontSize="14" Foreground="AliceBlue"/>

                    </Table>
                </FlowDocument>
            </FlowDocumentScrollViewer>
            </StackPanel>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50">
            <FlowDocumentScrollViewer IsToolBarVisible="False" VerticalScrollBarVisibility="Hidden">
                <FlowDocument>

                    <Table CellSpacing="5">

                        <Table.Columns>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                            <TableColumn Width="Auto"/>
                        </Table.Columns>

                        <TableRowGroup>

                            <TableRow Background="#FF80364E">
                                <TableCell ColumnSpan="9" TextAlignment="Center">
                                        <Paragraph FontWeight="DemiBold" FontSize="35" Foreground="AliceBlue">Planety spoza Sol Dominium</Paragraph>
                                </TableCell>
                            </TableRow>

                                <TableRow Background="PaleVioletRed" FontSize="14" FontWeight="DemiBold" Foreground="AliceBlue">
                                <TableCell>
                                    <Paragraph TextAlignment="Center" >Planeta</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center" >Żywność</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Energia</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Zadowolenie społeczne</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Autorytet władzy</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Produkcja żywności (co turę)</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Produkcja energii (co turę)</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Zużycie żywności (co turę)</Paragraph>
                                </TableCell>
                                <TableCell>
                                    <Paragraph TextAlignment="Center">Zużycie energii (co turę)</Paragraph>
                                </TableCell>
                            </TableRow>
                        </TableRowGroup>
                            <TableRowGroup x:Name="IndependentPlanetRows" FontSize="14" Foreground="AliceBlue"/>

                    </Table>
                </FlowDocument>
            </FlowDocumentScrollViewer>
            </StackPanel>

            <Label Grid.Row="2" HorizontalAlignment="Center" Content="SK - Sojusz Księżycowy" FontSize="20" Foreground="AliceBlue"/>
            <Button Grid.Row="3" Content="Wyjdź" Margin="10" Width="150" Height="40" FontSize="17" Click="LeaveStatistics_Click"/>
        </Grid>
    </Grid>
</UserControl>
