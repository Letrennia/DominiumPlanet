<UserControl x:Class="GraphicView.Statistics.PlanetStatisticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.Statistics"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <FlowDocumentScrollViewer Grid.Row="0" HorizontalAlignment="Center" IsToolBarVisible="False" VerticalScrollBarVisibility="Hidden" Width="1200">
            <FlowDocument>

                <Table CellSpacing="5">

                    <Table.Columns>
                        <TableColumn Width="70"/>
                        <TableColumn Width="70"/>
                        <TableColumn Width="100"/>
                        <TableColumn Width="100"/>
                        <TableColumn Width="100"/>
                        <TableColumn Width="140"/>
                        <TableColumn Width="140"/>
                        <TableColumn Width="120"/>
                        <TableColumn Width="120"/>
                    </Table.Columns>

                    <TableRowGroup>

                        <TableRow Background="SkyBlue">
                            <TableCell ColumnSpan="9" TextAlignment="Center">
                                <Paragraph FontSize="24pt" FontWeight="Bold">Sol Dominium</Paragraph>
                            </TableCell>
                        </TableRow>

                        <TableRow Background="LightGoldenrodYellow">
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center" >Planeta</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center" >Żywność</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Energia</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Zadowolenie społeczne</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Autorytet władzy</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Produkcja żywności (co turę)</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Produkcja energii (co turę)</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Zużycie żywności (co turę)</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Zużycie energii (co turę)</Paragraph>
                            </TableCell>
                        </TableRow>
                    </TableRowGroup>
                    <TableRowGroup x:Name="PlanetRows"/>

                </Table>
            </FlowDocument>
        </FlowDocumentScrollViewer>

        <FlowDocumentScrollViewer Grid.Row="1" HorizontalAlignment="Center" IsToolBarVisible="False" VerticalScrollBarVisibility="Hidden" Width="1200">
            <FlowDocument>

                <Table CellSpacing="5">

                    <Table.Columns>
                        <TableColumn Width="70"/>
                        <TableColumn Width="70"/>
                        <TableColumn Width="100"/>
                        <TableColumn Width="100"/>
                        <TableColumn Width="100"/>
                        <TableColumn Width="140"/>
                        <TableColumn Width="140"/>
                        <TableColumn Width="120"/>
                        <TableColumn Width="120"/>
                    </Table.Columns>

                    <TableRowGroup>

                        <TableRow Background="SkyBlue">
                            <TableCell ColumnSpan="9" TextAlignment="Center">
                                <Paragraph FontSize="24pt" FontWeight="Bold">Planety spoza Sol Dominium</Paragraph>
                            </TableCell>
                        </TableRow>

                        <TableRow Background="LightGoldenrodYellow">
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center" >Planeta</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center" >Żywność</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Energia</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Zadowolenie społeczne</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Autorytet władzy</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Produkcja żywności (co turę)</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Produkcja energii (co turę)</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Zużycie żywności (co turę)</Paragraph>
                            </TableCell>
                            <TableCell>
                                <Paragraph FontSize="10pt" FontWeight="Bold" TextAlignment="Center">Zużycie energii (co turę)</Paragraph>
                            </TableCell>
                        </TableRow>
                    </TableRowGroup>
                    <TableRowGroup x:Name="IndependentPlanetRows"/>

                </Table>
            </FlowDocument>
        </FlowDocumentScrollViewer>

        <Label Grid.Row="2" HorizontalAlignment="Center" Content="SK - Sojusz księżycowy"/>
        <Button Grid.Row="3" Content="Wyjdź" Margin="5" Click="LeaveStatistics_Click"/>

        
    </Grid>
</UserControl>
