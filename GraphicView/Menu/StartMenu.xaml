<UserControl x:Class="GraphicView.Menu.StartMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.Menu"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Witaj w SOL DOMINIUM!" FontSize="40" Margin="10, 10, 10, 0" HorizontalAlignment="Center"/>
                <TextBlock Text="Aby wybrać opcję użyj strzałek góra dół. Aby zatwierdzić opcje wciśnij enter." FontSize="20" Margin="10, 0, 10, 10"/>
                <Button Content="Nowa gra" Margin="5" Click="NewGame_Click"/>
                <Button Content="Wczytaj grę" Margin="5" Click="LoadGame_Click"/>
                <Button Content="Wyjdź" Margin="5" Click="EndGame_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
