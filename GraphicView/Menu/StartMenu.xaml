<UserControl x:Class="GraphicView.Menu.StartMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.Menu"
             xmlns:gif="http://wpfanimatedgif.codeplex.com"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Image Stretch="UniformToFill" gif:ImageBehavior.AnimatedSource="/Images/space-resized.gif"/>
        <StackPanel VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Witaj w SOL DOMINIUM!" FontSize="40" Foreground="AliceBlue" FontWeight="DemiBold" Margin="10" HorizontalAlignment="Center"/>
                <TextBlock Text="Aby wybrać opcję użyj strzałek góra dół. Aby zatwierdzić opcję wciśnij enter." FontSize="20" Foreground="AliceBlue" Margin="10, 0, 10, 10"/>
                <Button Content="Nowa gra" Margin="5" Width="200" Height="40" FontSize="20" Click="NewGame_Click"/>
                <Button Content="Wczytaj grę" Margin="5" Width="200" Height="40" FontSize="20" Click="LoadGame_Click"/>
                <Button Content="Wyjdź" Margin="5" Width="200" Height="40" FontSize="20" Click="EndGame_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
