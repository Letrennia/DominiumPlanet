<UserControl x:Class="GraphicView.Menu.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.Menu"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Image Source="/Images/galaxy-screen3.jpg" Stretch="UniformToFill"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Main Menu" FontSize="40" Foreground="AliceBlue" FontWeight="DemiBold" Margin="10"/>
            <Button Content="Raport" Margin="5" Width="200" Height="40" FontSize="20" Click="ShowRaport_Click"/>
            <Button Content="Przegląd planet" Margin="5" Width="200" Height="40" FontSize="20" Click="ShowPlanetsMenu_Click"/>
            <Button Content="Przeglądaj statystyki" Margin="5" Width="200" Height="40" FontSize="20" Click="ShowStatistics_Click"/>
            <Button Content="Decyzje" Margin="5" Width="200" Height="40" FontSize="20" Click="ShowDecisionMenu_Click"/>
            <Button Content="Zakoncz ture" Margin="5" Width="200" Height="40" FontSize="20" Click="EndTurn_Click"/>
            <Button Content="Zapisz grę" Margin="5" Width="200" Height="40" FontSize="20" Click="SaveGame_Click"/>
            <Button Content="Wyjdź" Margin="5" Width="200" Height="40" FontSize="20" Click="EndGame_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
