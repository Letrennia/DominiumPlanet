<UserControl x:Class="GraphicView.Menu.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.Menu"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Main Menu" FontSize="40" Margin="20"/>
            <Button Content="Raport" Margin="5" Click="ShowRaport_Click"/>
            <Button Content="Przeglad planet" Margin="5" Click="ShowPlanetsMenu_Click"/>
            <Button Content="Przegladaj statystyki" Margin="5" Click="ShowStatistics_Click"/>
            <Button Content="Decyzje" Margin="5" Click="ShowDecisionMenu_Click"/>
            <Button Content="Zakoncz ture" Margin="5" Click="EndTurn_Click"/>
            <Button Content="Zapisz gre" Margin="5" Click="SaveGame_Click"/>
            <Button Content="Wyjdz" Margin="5" Click="EndGame_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
