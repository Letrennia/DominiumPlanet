<UserControl x:Class="GraphicView.Menu.PlanetMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.Menu"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Image Source="/Images/planet-screen.jpg" Stretch="UniformToFill"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Wybierz planetę" FontSize="40" Foreground="AliceBlue" FontWeight="DemiBold" Margin="10, 10, 10, 0"/>
            <ItemsControl x:Name="PlanetItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" Tag="{Binding}" Margin="5" Width="200" Height="40" FontSize="20" Click="PlanetClicked_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Wyjdz" Margin="5" Width="200" Height="40" FontSize="20" Click="LeaveMenu_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
