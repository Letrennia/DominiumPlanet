<UserControl x:Class="GraphicView.PlanetInformation.PlanetDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.PlanetInformation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50 0 50 0">
            <TextBlock x:Name="PlanetName" FontSize="40" Foreground="AliceBlue" FontWeight="DemiBold" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="PlanetDescription" Margin="5" FontSize="20" Foreground="AliceBlue" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Justify"/>
            <TextBlock x:Name="PlanetIndependence" Margin="5" FontSize="20" Foreground="AliceBlue"/>
            <Button Content="Wyjdź" Click="LeavePlanet_Click" Margin="5" Width="200" Height="40" FontSize="20"/>
        </StackPanel>
    </Grid>
</UserControl>
