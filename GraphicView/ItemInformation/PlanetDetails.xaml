<UserControl x:Class="GraphicView.PlanetInformation.PlanetDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.PlanetInformation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PlanetName" FontSize="40"/>
            <TextBlock x:Name="PlanetDescription" FontSize="10" Margin="5" TextWrapping="Wrap"/>
            <TextBlock x:Name="PlanetIndependence" FontSize="10" Margin="5"/>
            <Button Content="Wyjdź" Click="LeavePlanet_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
