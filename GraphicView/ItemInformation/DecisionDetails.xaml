<UserControl x:Class="GraphicView.ItemInformation.DecisionDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.ItemInformation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="DecisionName" FontSize="32" FontWeight="Bold" TextAlignment="Center" Margin="10"/>
        <TextBlock Grid.Row="1" x:Name="DecisionDescription" FontSize="16" TextAlignment="Center" Margin="10"/>
        <TextBlock Grid.Row="2" x:Name="DecisionCost" FontSize="16" TextAlignment="Center" Margin="10"/>

        <StackPanel Grid.Row="3">
            <Button x:Name="DecisionOption1" FontSize="16" Margin="10" Click="Option1_Click"/>
            <Button x:Name="DecisionOption2" FontSize="16" Margin="10" Click="Option2_Click"/>
            
        </StackPanel>
        

        
    </Grid>
</UserControl>
