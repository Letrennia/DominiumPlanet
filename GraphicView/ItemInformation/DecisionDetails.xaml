<UserControl x:Class="GraphicView.ItemInformation.DecisionDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.ItemInformation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Image Source="/Images/galaxy-screen3.jpg" Stretch="UniformToFill"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50 0 50 0">
            <TextBlock x:Name="DecisionName" TextAlignment="Center" FontSize="40" Foreground="AliceBlue" FontWeight="DemiBold" Margin="10"/>
            <TextBlock x:Name="DecisionDescription" Margin="5" FontSize="20" Foreground="AliceBlue" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Justify"/>
            <TextBlock x:Name="DecisionCost" Margin="5" FontSize="20" Foreground="PaleVioletRed" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Justify"/>
            <Button x:Name="DecisionOption1" Margin="5" Width="400" Height="40" FontSize="20" Click="Option1_Click"/>
            <Button x:Name="DecisionOption2" Margin="5" Width="400" Height="40" FontSize="20" Click="Option2_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
