<UserControl x:Class="GraphicView.Plot.PlotDominium"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.Plot"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="GameTitle" FontSize="40"/>
            <TextBlock x:Name="GamePlot" FontSize="10" Margin="5" TextWrapping="Wrap"/>
            <TextBlock x:Name="GameRules" FontSize="10" Margin="5"/>
            <Button Content="Kontynuuj" Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
