<UserControl x:Class="GraphicView.Plot.PlotDominium"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.Plot"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Image Source="/Images/galaxy-screen2.jpg" Stretch="UniformToFill"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50 0 50 0">
            <TextBlock x:Name="GameTitle" FontSize="40" Foreground="AliceBlue" FontWeight="DemiBold" Margin="10" HorizontalAlignment="Center"/>
            <TextBlock x:Name="GamePlot" FontSize="17" Foreground="AliceBlue" TextAlignment="Justify" TextWrapping="Wrap"/>
            <TextBlock x:Name="GameRules" FontSize="17" Foreground="AliceBlue" TextAlignment="Justify" TextWrapping="Wrap"/>
            <Button Content="Kontynuuj" Margin="10" Width="150" Height="40" FontSize="17" 
                    Background="Transparent" BorderThickness="2" BorderBrush="AliceBlue" Foreground="AliceBlue"
                    Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
