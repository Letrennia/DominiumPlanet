<UserControl x:Class="GraphicView.Plot.AnimationFile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphicView.Plot"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Black">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <Grid Width="250" Height="250">
                <Ellipse Width="150" Height="150" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="25" Height="25" Fill="PaleVioletRed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0">

                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="MoonRotation" CenterX="12.5" CenterY="120"/>
                    </Ellipse.RenderTransform>

                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="MoonRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:2" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>

                </Ellipse>
            </Grid>
            <TextBlock x:Name="TurnText" Text="TURA 1" FontSize="40" Foreground="PaleVioletRed" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>
        </StackPanel>
    </Grid>
</UserControl>
